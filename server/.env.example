# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/otess_sms?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=otess_data_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=30d

# Default Arkesel SMS Gateway Credentials (Can also be configured via Settings UI)
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=OTESS DATA

# Allowed Frontend URL for CORS Security
CLIENT_URL=http://localhost:5173
